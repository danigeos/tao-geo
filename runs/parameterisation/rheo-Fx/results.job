#!/bin/csh

set  ps = results.ps

psbasemap -JX14/14 -R-16/16/-3500/3000 \
	-B:."Effect of changing F@-x@-":a2f1g100:"F@-x@- [TN/m]":/a500f100:"-w@-max@- [m]": \
	-K -P -X3.5 -Y3 > $ps

pstext -JX -R -O -K <<END>> $ps
	0	1800	16 0 1 3	F@-z@-=3 TN/m\ 
	0	-2500	16 0 1 3	F@-z@-=-3 TN/m\ 
END

psxy results.wFx -M -JX -R -O >> $ps


