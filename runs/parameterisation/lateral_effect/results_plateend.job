#csh

set model  	= plate   #plate or load

set ps   	= results_$model\end.ps
set Lmax  	= 300
set wasint 	= 425
set ymin	= -10

echo deflexion asintotica = $wasint

#MAKE CALCULATIONS:
#awk -f get_results_$model\end.awk > results_$model\end.Te-L-w0


#Relative Error in deflection at 0
awk '{if ($1==">") print ">"; else print $2, (wasint-$3)/wasint*100}' wasint=$wasint results_$model\end.Te-L-w0 | \
	psxy -JX7/10 -R0/$Lmax/$ymin/100 -X3 -Y4 -W5 -M -K -P \
		-B:"domain length L (km)":a50f10/a10f5g200:"difference in w@-f@- (%)":SW  > $ps
psxy -JX -R -W1ta -O -M -K <<END>> $ps
>
	0	0
	400	0
>
	0	10
	400	10
END
pstext -JX -R -O -K <<END>> $ps
	160 80 15 0 0 2 	change in deflection
	1   1  10 0 1 1		10
	50 18 10 0 1 1		Te=80 km
END


#Relative Error in basin volume
invertfile results_$model\end.Te-L-w0 | \
	awk '(substr($1,1,1)!="#"){if ($1==">") {print ">"; signal=1;} else {if (signal==1) asint=$4; signal=0; print $2, (asint-$4)/asint*100;}}' | \
	psxy -JX -R -X8.5 -W5 -M -O -K \
		-B:"domain length L (km)":a50f10/a10f5g200:"difference in V@-basin@- (%)":SW  >> $ps
psxy -JX -R -W1ta -O -M -K <<END>> $ps
>
	0	0
	400	0
>
	0	10
	400	10
END
pstext -JX -R -O <<END>> $ps
	160 80 15 0 0 2 	change in volume
	40 4 10 0 1 2		Te=10 km
	190 14 10 0 1 2		Te=80 km
END


