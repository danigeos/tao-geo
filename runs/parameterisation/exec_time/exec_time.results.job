#!/bin/csh

set ps	= exec_time.results.ps


psbasemap -JX22l/16l -R2/90000/.1/3000 -K -X2.8 -Y2 \
	-B:."tao 2D & 3D Execution Time as a function of gridding and model type":a1000f100:Nx:/50f10:"Time (s)": \
		> $ps

psxy 	-JX -R -K -O -L -W15ta/100/100/100 -G230	<< END	>> $ps
	100	1000
	1000000	1000
	1000000	.001
	100	.001
END

psxy 	-JX -R -K -O -B -L -W10ta -G200	<< END	>> $ps
#	40	230
#	90	230
#	90	70
#	60	8
#	40	2.3
END

cat exec_time.results | psxy -JX -R -M -W10 -H7 -O -K >> $ps

cat exec_time.results | psxy -JX -R -Sd.06 -H7 -K -O -M -K >> $ps

pstext	-JX -R -O				<< END	>> $ps
	2500	1	16 0 1 1	2D.Elast.Instant.
	10000	7	16 0 1 1	2D.Elast.E&S
	17000	20	16 0 1 3	2D.Viscoel.E&S
	5000	130	16 0 1 1	2D.Elastoplast.E&S.
	105	50	16 0 1 1	3D.Elast.Instant.
	80	80	16 0 1 1	3D.E&S.NoLakes
	60	150	16 0 1 1	3D.E&S.Lakes
	50	190	16 0 1 3	3D.Elast.E&S.Lakes
END


